DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters

# Used once by `npm run auth:bootstrap` to create your account and attach existing data.
# Login itself reads from the users table after bootstrap.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD_HASH=scrypt:SALT_BASE64URL:HASH_BASE64URL
