    "auth:hash": "tsx scripts/hash-password.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-multiuser.ts",
    "auth:create-user": "tsx scripts/create-user.ts",
    "auth:set-password": "tsx scripts/set-password.ts",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "db:setup": "drizzle-kit generate && drizzle-kit migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.9",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
